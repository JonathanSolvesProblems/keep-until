{
  "hosting": {
    "public": "web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "remoteconfig": {
    "template": "remoteconfig.template.json"
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Keep Until",
        "supportEmail": "jon.knight.andrei@gmail.com",
        "authorizedRedirectUris": [
          "https://keep-until-hybrid.firebaseapp.com/__/auth/handler",
          "http://localhost"
        ]
      }
    }
  }
}
