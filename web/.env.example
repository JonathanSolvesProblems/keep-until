# Copy to web/.env.local and fill in from your own Firebase project (never commit .env.local).
# Firebase console > Project settings > Your apps > Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check: a reCAPTCHA Enterprise site key registered for this web app
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# App Check debug token for localhost, registered under App Check > Apps > Manage debug tokens
VITE_APPCHECK_DEBUG_TOKEN=
